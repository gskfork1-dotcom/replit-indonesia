const express = require('express')
const cors = require('cors')
const fs = require('fs')
const path = require('path')
const bcrypt = require('bcryptjs')
const jwt = require('jsonwebtoken')

const app = express()
const PORT = 3001
const JWT_SECRET = process.env.JWT_SECRET || 'replit-indonesia-demo-secret'
const DATA_PATH = path.join(__dirname, 'data', 'db.json')

app.use(cors())
app.use(express.json({ limit: '2mb' }))

function ensureDataFile() {
  const dir = path.dirname(DATA_PATH)
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true })
  }

  if (!fs.existsSync(DATA_PATH)) {
    fs.writeFileSync(DATA_PATH, JSON.stringify({ users: [], projects: [] }, null, 2))
  }
}

function readDb() {
  ensureDataFile()
  return JSON.parse(fs.readFileSync(DATA_PATH, 'utf8'))
}

function writeDb(data) {
  ensureDataFile()
  fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2))
}

function signToken(user) {
  return jwt.sign({ id: user.id, email: user.email, name: user.name }, JWT_SECRET, {
    expiresIn: '7d'
  })
}

function authenticate(req, res, next) {
  const authHeader = req.headers.authorization || ''
  const token = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : null

  if (!token) {
    return res.status(401).json({ message: 'Token tidak ditemukan.' })
  }

  try {
    const payload = jwt.verify(token, JWT_SECRET)
    req.user = payload
    return next()
  } catch (error) {
    return res.status(401).json({ message: 'Token tidak valid.' })
  }
}

function makeProjectFiles(language) {
  const fileMap = {
    React: {
      path: 'src/App.jsx',
      content: `import React from 'react'

export default function App() {
  return (
    <main className="page-shell">
      <h1>Halo dari Replit Indonesia</h1>
      <p>Project React Anda siap dikembangkan.</p>
    </main>
  )
}
`
    },
    'Node.js': {
      path: 'server.js',
      content: `const express = require('express');
const app = express();

app.get('/', (req, res) => {
  res.json({ message: 'Halo dari API Replit Indonesia' });
});

app.listen(3000, () => {
  console.log('Server berjalan di http://localhost:3000');
});
`
    },
    Python: {
      path: 'main.py',
      content: `print('Halo dari Replit Indonesia')
print('Project Python Anda siap dibuat.')
`
    }
  }

  return [fileMap[language] || fileMap.React]
}

app.get('/api/health', (req, res) => {
  res.json({ ok: true, message: 'Replit Indonesia API siap.' })
})

app.post('/api/register', async (req, res) => {
  const { name, email, password } = req.body || {}

  if (!name || !email || !password) {
    return res.status(400).json({ message: 'Nama, email, dan password wajib diisi.' })
  }

  const db = readDb()
  const exists = db.users.some((user) => user.email.toLowerCase() === email.toLowerCase())

  if (exists) {
    return res.status(409).json({ message: 'Email sudah terdaftar.' })
  }

  const passwordHash = await bcrypt.hash(password, 10)
  const newUser = {
    id: `user_${Date.now()}`,
    name,
    email: email.toLowerCase(),
    password: passwordHash,
    createdAt: new Date().toISOString()
  }

  db.users.push(newUser)
  writeDb(db)

  const token = signToken(newUser)
  return res.status(201).json({ token, user: { id: newUser.id, name: newUser.name, email: newUser.email } })
})

app.post('/api/login', async (req, res) => {
  const { email, password } = req.body || {}

  if (!email || !password) {
    return res.status(400).json({ message: 'Email dan password wajib diisi.' })
  }

  const db = readDb()
  const user = db.users.find((item) => item.email.toLowerCase() === String(email).toLowerCase())

  if (!user) {
    return res.status(401).json({ message: 'Email tidak ditemukan.' })
  }

  const valid = await bcrypt.compare(password, user.password)
  if (!valid) {
    return res.status(401).json({ message: 'Password salah.' })
  }

  const token = signToken(user)
  return res.json({ token, user: { id: user.id, name: user.name, email: user.email } })
})

app.get('/api/me', authenticate, (req, res) => {
  const db = readDb()
  const user = db.users.find((item) => item.id === req.user.id)

  if (!user) {
    return res.status(404).json({ message: 'User tidak ditemukan.' })
  }

  return res.json({ user: { id: user.id, name: user.name, email: user.email } })
})

app.get('/api/projects', authenticate, (req, res) => {
  const db = readDb()
  const projects = db.projects
    .filter((project) => project.userId === req.user.id)
    .sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt))

  return res.json({ projects })
})

app.post('/api/projects', authenticate, (req, res) => {
  const { name, language, description } = req.body || {}

  if (!name || !language) {
    return res.status(400).json({ message: 'Nama project dan bahasa pemrograman wajib diisi.' })
  }

  const db = readDb()
  const project = {
    id: `project_${Date.now()}`,
    userId: req.user.id,
    name,
    language,
    description: description || `Project ${name} dibuat dengan ${language}`,
    files: makeProjectFiles(language),
    lastRunOutput: '',
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString()
  }

  db.projects.push(project)
  writeDb(db)

  return res.status(201).json({ project })
})

app.put('/api/projects/:id/files', authenticate, (req, res) => {
  const { path, content } = req.body || {}
  const { id } = req.params

  if (!path || typeof content !== 'string') {
    return res.status(400).json({ message: 'Path dan content file wajib diisi.' })
  }

  const db = readDb()
  const project = db.projects.find((item) => item.id === id && item.userId === req.user.id)

  if (!project) {
    return res.status(404).json({ message: 'Project tidak ditemukan.' })
  }

  project.files = project.files.map((file) =>
    file.path === path ? { ...file, content } : file
  )
  project.updatedAt = new Date().toISOString()
  writeDb(db)

  return res.json({ ok: true, project })
})

app.post('/api/projects/:id/run', authenticate, (req, res) => {
  const { path, content } = req.body || {}
  const { id } = req.params

  const db = readDb()
  const project = db.projects.find((item) => item.id === id && item.userId === req.user.id)

  if (!project) {
    return res.status(404).json({ message: 'Project tidak ditemukan.' })
  }

  if (path && content !== undefined) {
    project.files = project.files.map((file) => (file.path === path ? { ...file, content } : file))
  }

  const firstFile = project.files[0]
  const output = `Running ${project.name} (${project.language})\n` +
    `File: ${firstFile?.path || 'main'}\n` +
    `Preview: ${firstFile?.content?.slice(0, 120) || 'No content'}\n` +
    `Status: ready` 

  project.lastRunOutput = output
  project.updatedAt = new Date().toISOString()
  writeDb(db)

  return res.json({ ok: true, output })
})

app.listen(PORT, () => {
  console.log(`Replit Indonesia API berjalan di http://localhost:${PORT}`)
})
